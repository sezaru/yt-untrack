{
  "manifest_version": 2,
  "name": "yt-untrack",
  "version": "0.2.0",
  "description": "Per-container YouTube: watch signed-in (premium, no ads) without recording history or influencing recommendations.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-untrack@sezdm.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "contextualIdentities",
    "cookies",
    "storage",
    "tabs",
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "yt-untrack",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
